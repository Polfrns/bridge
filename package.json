{
  "name": "ai-librechat-bridge",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "setup": "node scripts/setup.mjs",
