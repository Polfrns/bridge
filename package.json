    "check:workspace": "node --env-file=.env scripts/check-workspace.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.291",
    "@openai/codex-sdk": "0.161.0",
    "zod": "4.6.5"
  }
}
