# Each installation generates its own bridge key with npm run setup.
BRIDGE_API_KEY=
# Windows/local clients: loopback. Ubuntu + Docker Engine: npm run setup:ubuntu
# selects the actual Docker host gateway interface; do not keep loopback there.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=4000
REQUEST_TIMEOUT_MS=180000
MAX_CONCURRENT_REQUESTS=2
# Empty means the provider default. These are actual backend model IDs/aliases,
# not the virtual claude-max and gpt-codex names exposed to LibreChat.
CLAUDE_MODEL=
CODEX_MODEL=
# Optional backend models for Fast/Deep. Empty: Codex uses CODEX_MODEL/the CLI
# default; Claude Fast uses sonnet, Claude Deep uses opus.
CODEX_FAST_MODEL=
CODEX_DEEP_MODEL=
CLAUDE_FAST_MODEL=
CLAUDE_DEEP_MODEL=
# Optional absolute paths to native executables, not .cmd launchers.
CLAUDE_EXECUTABLE=
CODEX_EXECUTABLE=
# Windows native sandbox for fresh per-request homes: unelevated (compatibility)
# or elevated (requires administrator-approved native sandbox setup).
CODEX_WINDOWS_SANDBOX=unelevated
# This setting is ignored on Linux: Codex uses its native Linux sandbox.

# Single shared file login; override only if the CLI login uses a custom directory.
CODEX_AUTH_DIR=
CLAUDE_AUTH_DIR=
# Optional explicit backend-model allowlists (comma-separated).
CODEX_ALLOWED_MODELS=
CLAUDE_ALLOWED_MODELS=sonnet,opus,haiku
# Absolute data directory recommended. Request state is private and removed after use.
BRIDGE_DATA_DIR=

# Failure categories are logged normally; opt in to raw commands/output locally.
BRIDGE_DEBUG_PROVIDER=0

# Docker Compose: optional localhost port; internal port is always 4000.
# BRIDGE_PUBLISHED_PORT=4000
# See DOCKER.md. Compose uses /auth and /data, ignoring native executable paths.

# Optional administrator-provisioned file tools (native Windows/Linux).
# Empty: search PATH; LibreOffice also searches Program Files on Windows.
BRIDGE_SOFFICE=
BRIDGE_FFMPEG=
BRIDGE_FFPROBE=
BRIDGE_TESSERACT=
BRIDGE_OCR_LANG=eng+spa
# Speech is optional: local faster-whisper model directory, never downloaded per request.
# Install with npm run setup:files -- --media; mount the model read-only in Docker.
BRIDGE_WHISPER_MODEL=
